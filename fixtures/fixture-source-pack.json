  "document_chunks": [
    {
      "chunk_id": "chunk:hoyolab-5-0-character-updates",
      "source_id": "src:hoyolab-version-5-0",
      "document_locator": "https://www.hoyolab.com/article/32456789#character-updates",
      "text": "5.0版本更新說明：修正了部分角色在特定狀態下的天賦描述文本，神里綾華的元素爆發「神里流·霜滅」冷卻時間與能量消耗維持原設定。",
      "token_hint": 48,
      "game_version": "5.0",
      "entity_ids": ["ent:kamisato-ayaka"]
    },
    {
      "chunk_id": "chunk:hoyolab-2-1-raiden-overview",
      "source_id": "src:hoyolab-version-2-1",
      "document_locator": "https://www.hoyolab.com/article/7890123#raiden-shogun",
      "text": "2.1版本新角色「一心淨土·雷電將軍（雷）」，使用長柄武器，元素戰技為「神變·惡曜開眼」，元素爆發為「奧義·夢想真說」。",
      "token_hint": 52,
      "game_version": "2.1",
      "entity_ids": ["ent:raiden-shogun", "ent:inazuma"]
    },
    {
      "chunk_id": "chunk:genshin-db-engulfing-description",
      "source_id": "src:genshin-db-weapons",
      "document_locator": "repo:weapons/engulfing-lightning#description",
      "text": "薙草之稻光：用於「斬草」的薙刀。對向這柄武器露出鋒芒的軍勢，大概也如同草芥一般吧…攻擊力獲得提升，提升程度相當於元素充能效率超出100%部分的28%。",
      "token_hint": 65,
      "game_version": "unknown",
      "entity_ids": ["ent:engulfing-lightning", "ent:raiden-shogun"]
    },
    {
      "chunk_id": "chunk:genshin-db-amakumo-fruit-details",
      "source_id": "src:genshin-db-materials",
      "document_locator": "repo:materials/amakumo-fruit#details",
      "text": "天雲草實：生長在清籟島的天雲草結出的果實，貼在耳畔能聽見微弱的雷鳴聲。為雷電將軍等稻妻角色的突破素材。",
      "token_hint": 44,
      "game_version": "5.0",
      "entity_ids": ["ent:amakumo-fruit", "ent:raiden-shogun", "ent:inazuma"]
    },
    {
      "chunk_id": "chunk:fandom-raiden-story-euthymia",
      "source_id": "src:fandom-raiden-shogun",
      "document_locator": "https://genshin-impact.fandom.com/wiki/Raiden_Shogun/Lore#Plane_of_Euthymia",
      "text": "雷電將軍在「一心淨土」中冥想追求永恆，對外界頒布了眼狩令與鎖國令，後在旅行者與八重神子的引導下重新審視稻妻人民的願望。",
      "token_hint": 56,
      "game_version": "4.8",
      "entity_ids": ["ent:raiden-shogun", "ent:inazuma"]
    },
    {
      "chunk_id": "chunk:fandom-kamisato-ayaka-lore",
      "source_id": "src:fandom-kamisato-ayaka",
      "document_locator": "https://genshin-impact.fandom.com/wiki/Kamisato_Ayaka/Story#Vision",
      "text": "神里綾華為社奉行神里家的大小姐，端莊嫻雅，深得稻妻民眾愛戴，被尊稱為「白鷺公主」。",
      "token_hint": 42,
      "game_version": "3.4",
      "entity_ids": ["ent:kamisato-ayaka", "ent:inazuma"]
    },
    {
      "chunk_id": "chunk:fandom-unclassified-world-lore",
      "source_id": "src:fandom-world-lore",
      "document_locator": "https://genshin-impact.fandom.com/wiki/Teyvat#Cosmology",
      "text": "提瓦特大陸的天空由虛假的星空所籠罩，世界底層流淌著地脈能量與古老的深淵侵蝕力量，此段為未關聯特定角色的宏觀世界觀敘述。",
      "token_hint": 50,
      "game_version": "unknown",
      "entity_ids": []
    }
  ],
